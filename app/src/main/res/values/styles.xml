<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">@color/dji_blue</item>
    </style>


    <style name="Text.White">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.White.Large">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
    </style>


    <style name="ControlButton">
        <item name="android:background">@drawable/bg_control_button</item>
        <item name="android:textColor">@color/control_btn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StatusText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="VisionText">
        <item name="android:textColor">@color/vision_text</item>
        <item name="android:textSize">16sp</item>
    </style>


    <style name="StatusPanelBackground">
        <item name="android:background">@drawable/bg_status_panel</item>
    </style>

    <style name="VisionPanelBackground">
        <item name="android:background">@drawable/bg_status_panel</item>
    </style>

</resources>
