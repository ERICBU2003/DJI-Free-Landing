<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/videoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <ImageView
        android:id="@+id/djiLogo"
        android:layout_width="90dp"
        android:layout_height="35dp"
        android:layout_margin="16dp"
        android:src="@drawable/dji_logo_white"
        android:scaleType="fitCenter"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />


    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_status_panel"
        android:layout_margin="16dp"
        android:gravity="end">

        <TextView
            android:id="@+id/txtConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery: --%"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtGPS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: --"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/visionPanel"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_status_panel"
        android:padding="10dp"
        android:layout_margin="12dp">

        <TextView
            android:id="@+id/txtCx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="cx: 0"
            android:textSize="16sp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/txtCy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="cy: 0"
            android:textSize="16sp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/txtValid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="valid: false"
            android:textSize="16sp"
            android:textColor="@color/white" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#88000000">

        <Button
            android:id="@+id/btnTakeoff"
            style="@style/ControlButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_takeoff" />

        <Button
            android:id="@+id/btnLand"
            style="@style/ControlButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_land" />

        <Button
            android:id="@+id/btnHover"
            style="@style/ControlButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_hover" />

        <Button
            android:id="@+id/btnVS"
            style="@style/ControlButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/btn_vs_on" />

        <Button
            android:id="@+id/btnMap"
            style="@style/ControlButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Map" />
    </LinearLayout>

</RelativeLayout>
